# Bhionex API Configuration
API_BASE_URL=https://api.bhionex.com
BOT_API_KEY=your_bot_api_key_here

# MT5 Cloner Configuration
# Path to your master MT5 folder that acts as the template
MASTER_MT5_DIR=C:/path/to/master/MT5

# Directory where all cloned user accounts will be created
CLIENTS_DIR=C:/path/to/MT5_clients

# Orchestrator Configuration
# The sync/polling interval in seconds (default: 60)
ORCHESTRATOR_INTERVAL=60
# Stagger delay in seconds between spawning consecutive workers (default: 15 for Wine, 5 for Windows)
WORKER_SPAWN_DELAY=15

# Worker Configuration
# The sync/polling interval in seconds for the standalone worker
WORKER_SYNC_INTERVAL=30
HISTORY_DAYS=7
CONFIG_TEMPLATE=example.ini
WORKER_EXPERT=FCE
WORKER_SYMBOL=XAUUSD
WORKER_TIMEFRAME=M1

# Mock Server Configuration
MOCK_SERVER_PORT=5000

# Validator API Configuration
# VALIDATOR_PORT=5001
# VALIDATION_TIMEOUT=30
# VALIDATOR_THREADS=4



